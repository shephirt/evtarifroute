# Database
POSTGRES_USER=evtarif
POSTGRES_PASSWORD=changeme
POSTGRES_DB=evtarif
DATABASE_URL=postgresql+psycopg2://evtarif:changeme@db:5432/evtarif

# External APIs
# Get a free key at https://openchargemap.org/site/develop/api — required
# for the ETL to actually fetch data; if left empty, ETL runs are skipped
# gracefully (logged, no error).
OCM_API_KEY=
ORS_API_KEY=your_openrouteservice_api_key

# ETL configuration
# Comma-separated ISO country codes for OpenChargeMap ingestion
TARGET_REGIONS=DE,AT,CH,NL
# How often (in hours) the app runs the OCM ingestion in the background.
# Set to 0 to disable the periodic schedule (manual trigger via
# POST /api/etl/run still works).
ETL_INTERVAL_HOURS=24

# Production deployment only (docker-compose.prod.yml).
# Set to your real, publicly resolvable domain for Caddy to obtain a
# Let's Encrypt certificate automatically. Not used in local/dev compose.
DOMAIN=

# Production deployment only (docker-compose.prod.yml).
# Which pre-built image to pull (published by .github/workflows/docker-image.yml
# to GitHub Container Registry). Replace OWNER/REPO with your actual GitHub
# org/user and repository name once pushed. Not used in local/dev compose,
# which always builds from source instead.
GHCR_IMAGE=ghcr.io/shephirt/evtarifroute
IMAGE_TAG=latest
