# Database
POSTGRES_USER=evtarif
POSTGRES_PASSWORD=changeme
POSTGRES_DB=evtarif
DATABASE_URL=postgresql+psycopg2://evtarif:changeme@db:5432/evtarif

# External APIs
# Get a free key at https://openchargemap.org/site/develop/api — required
# for the ETL to actually fetch data; if left empty, ETL runs are skipped
# gracefully (logged, no error).
OCM_API_KEY=
ORS_API_KEY=your_openrouteservice_api_key

# ETL configuration
# Comma-separated ISO country codes for OpenChargeMap ingestion
TARGET_REGIONS=DE,AT,CH,NL
# How often (in hours) the app runs the OCM ingestion in the background.
# Set to 0 to disable the periodic schedule (manual trigger via
# POST /api/etl/run still works).
ETL_INTERVAL_HOURS=24

# Production deployment only (compose.yaml).
# Which image tag to pull from ghcr.io/shephirt/evtarifroute (published by
# .github/workflows/docker-image.yml). Defaults to "latest"; pin to a
# specific version (e.g. "0.1.0") for reproducible deployments. Not used in
# local/dev compose, which always builds from source instead.
IMAGE_TAG=latest
